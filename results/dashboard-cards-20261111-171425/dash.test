eval instant at 1m label_join(sum by (tenant, card, namespace) (gputenant_gpu_card_memory_allocated_mib) or label_replace(max by (tenant, card) (gputenant_gpu_card_memory_capacity_mib) - (sum by (tenant, card) (gputenant_gpu_card_memory_allocated_mib) or max by (tenant, card) (gputenant_gpu_card_memory_capacity_mib) * 0), "namespace", "空闲", "", ""), "gpu", "\n", "tenant", "card")
