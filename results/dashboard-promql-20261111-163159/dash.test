load 15s
  gputenant_tenant_ready{tenant="tenant-a", job="gputenant", instance="172.18.0.1:18080"} 1x10
  gputenant_tenant_ready{tenant="tenant-b", job="gputenant", instance="172.18.0.1:18080"} 1x10
  gputenant_tenant_ready{tenant="tenant-c", job="gputenant", instance="172.18.0.1:18080"} 0x10
  gputenant_tenant_ready{tenant="tenant-d", job="gputenant", instance="172.18.0.1:18080"} 0x10
  gputenant_tenant_degraded{tenant="tenant-a", job="gputenant", instance="172.18.0.1:18080"} 0x10
  gputenant_tenant_degraded{tenant="tenant-b", job="gputenant", instance="172.18.0.1:18080"} 1x10
  gputenant_tenant_degraded{tenant="tenant-c", job="gputenant", instance="172.18.0.1:18080"} 0x10
  gputenant_tenant_degraded{tenant="tenant-d", job="gputenant", instance="172.18.0.1:18080"} 0x10
  gputenant_tenant_steps_done{tenant="tenant-a", job="gputenant", instance="172.18.0.1:18080"} 14x10
  gputenant_tenant_steps_done{tenant="tenant-b", job="gputenant", instance="172.18.0.1:18080"} 14x10
  gputenant_tenant_steps_done{tenant="tenant-c", job="gputenant", instance="172.18.0.1:18080"} 8x10
  gputenant_tenant_steps_done{tenant="tenant-d", job="gputenant", instance="172.18.0.1:18080"} 0x10
  gputenant_tenant_steps_total{tenant="tenant-a", job="gputenant", instance="172.18.0.1:18080"} 14x10
  gputenant_tenant_steps_total{tenant="tenant-b", job="gputenant", instance="172.18.0.1:18080"} 14x10
  gputenant_tenant_steps_total{tenant="tenant-c", job="gputenant", instance="172.18.0.1:18080"} 14x10
  gputenant_tenant_steps_total{tenant="tenant-d", job="gputenant", instance="172.18.0.1:18080"} 0x10
  gputenant_tenant_inspect_errors{tenant="tenant-a", job="gputenant", instance="172.18.0.1:18080"} 0x10
  gputenant_tenant_inspect_errors{tenant="tenant-b", job="gputenant", instance="172.18.0.1:18080"} 0x10
  gputenant_tenant_inspect_errors{tenant="tenant-c", job="gputenant", instance="172.18.0.1:18080"} 0x10
  gputenant_tenant_inspect_errors{tenant="tenant-d", job="gputenant", instance="172.18.0.1:18080"} 1x10
  gputenant_alert_firing{tenant="tenant-b", alertname="ApiserverToNodePathDown", job="gputenant", instance="172.18.0.1:18080"} 1x10
  gputenant_alert_firing{tenant="tenant-b", alertname="KonnectivityAgentDisconnected", job="gputenant", instance="172.18.0.1:18080"} 1x10

eval instant at 1m (count(gputenant_tenant_ready) - sum(gputenant_tenant_ready)) * on () group_left (ready, total) (count_values("ready", sum(gputenant_tenant_ready)) * on () group_left (total) count_values("total", count(gputenant_tenant_ready)))
  {ready="2", total="4"} 2

eval instant at 1m max by (tenant, status) (label_replace(max by (tenant) (gputenant_tenant_degraded) == 1, "status", "降级", "", "") or on (tenant) label_replace(max by (tenant) (gputenant_tenant_ready) == 1, "status", "就绪", "", "") or on (tenant) label_replace(max by (tenant) (gputenant_tenant_inspect_errors) > 0, "status", "读取失败", "", "") or on (tenant) label_replace(label_join(count_values by (tenant) ("done", max by (tenant) (gputenant_tenant_steps_done)) * on (tenant) group_left (total) count_values by (tenant) ("total", max by (tenant) (gputenant_tenant_steps_total)), "status", "/", "done", "total"), "status", "开通中 $1", "status", "(.*)"))
  {tenant="tenant-a", status="就绪"} 1
  {tenant="tenant-b", status="降级"} 1
  {tenant="tenant-c", status="开通中 8/14"} 1
  {tenant="tenant-d", status="读取失败"} 1

eval instant at 1m max by (tenant, alertname) (gputenant_alert_firing == 1)
  {tenant="tenant-b", alertname="ApiserverToNodePathDown"} 1
  {tenant="tenant-b", alertname="KonnectivityAgentDisconnected"} 1

clear
load 15s
  gputenant_tenant_ready{tenant="tenant-a", job="gputenant", instance="172.18.0.1:18080"} 1x10
  gputenant_tenant_ready{tenant="tenant-b", job="gputenant", instance="172.18.0.1:18080"} 1x10

eval instant at 1m (count(gputenant_tenant_ready) - sum(gputenant_tenant_ready)) * on () group_left (ready, total) (count_values("ready", sum(gputenant_tenant_ready)) * on () group_left (total) count_values("total", count(gputenant_tenant_ready)))
  {ready="2", total="2"} 0
