      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gputenant_tenant_ready",
          "legendFormat": "ready",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gputenant_tenant_degraded",
          "legendFormat": "degraded",
          "instant": true,
          "format": "table"
